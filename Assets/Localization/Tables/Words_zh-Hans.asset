    m_Metadata:
      m_Items: []
  - m_Id: 867233798
    m_Localized: "\u5728\u7B2C\u4E8C\u6B21\u4E16\u754C\u5927\u6218\u671F\u95F4\uFF0C\u7EB3\u7CB9\u5FB7\u56FD\u4F7F\u7528\u4E86\u4E00\u79CD\u88AB\u79F0\u4E3A\u65E0\u9650\u6F5C\u6C34\u8247\u7684\u6F5C\u6C34\u8247\uFF0C\u65E8\u5728\u5BF9\u654C\u65B9\u7ECF\u6D4E\u9020\u6210\u635F\u5BB3\u3002<br>\n\u672C\u6E38\u620F\u7684\u76EE\u7684\u662F\u4F5C\u4E3A\u4E8C\u6218\u65F6\u671F\u5FB7\u56FD\u6F5C\u6C34\u8247U-BOAT\u7684\u8230\u957F\uFF0C\u6307\u6325\u6F5C\u6C34\u8247\u5E76\u901A\u8FC7\u9C7C\u96F7\u653B\u51FB\u51FB\u6C89\u654C\u65B9\u8230\u8239\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233799
    m_Localized: "\u6E38\u620F\u6A21\u5F0F"
    m_Metadata:
      m_Items: []
  - m_Id: 867233800
    m_Localized: "\u6E38\u620F\u6A21\u5F0F\u5305\u62EC\u300C\u906D\u9047\u6218\u300D\u548C\u300C\u4EFB\u52A1\u300D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233801
    m_Localized: "\u300C\u906D\u9047\u6218\u300D\u662F\u4E3A\u77ED\u65F6\u95F4\u6E38\u620F\u8BBE\u8BA1\u7684\uFF0C\u6E38\u620F\u5F00\u59CB\u65F6\u4F60\u5DF2\u7ECF\u6DF1\u5165\u654C\u65B9\u8230\u961F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233802
    m_Localized: "\u8EB2\u907F\u9A71\u9010\u8230\u7684\u653B\u51FB\u5E76\u52AA\u529B\u51FB\u6C89\u5546\u8239\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233803
    m_Localized: "\u300C\u4EFB\u52A1\u300D\u5F00\u59CB\u65F6\u9700\u8981\u5BFB\u627E\u654C\u4EBA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233804
    m_Localized: "\u4F7F\u7528\u6F5C\u671B\u955C\u6DF1\u5EA6\u5B9A\u4F4D\u654C\u65B9\u8230\u961F\uFF0C\u6084\u6084\u63A5\u8FD1\u5E76\u5C1D\u8BD5\u51FB\u6C89\u5546\u8239\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233805
    m_Localized: "\u96BE\u5EA6"
    m_Metadata:
      m_Items: []
  - m_Id: 867233806
    m_Localized: "\u6839\u636E\u96BE\u5EA6\uFF0C\u654C\u8230\u6570\u91CF\u548C\u5B8C\u6210\u4EFB\u52A1\u6240\u9700\u51FB\u6C89\u7684\u5428\u6570\u4F1A\u53D1\u751F\u53D8\u5316\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233807
    m_Localized: "\u9A71\u9010\u8230\u6570\u91CF"
    m_Metadata:
      m_Items: []
  - m_Id: 867233808
    m_Localized: "\u5546\u8239\u6570\u91CF"
    m_Metadata:
      m_Items: []
  - m_Id: 867233809
    m_Localized: "\u51FB\u6C89\u5428\u6570"
    m_Metadata:
      m_Items: []
  - m_Id: 867233810
    m_Localized: "\u64CD\u4F5C\u8BF4\u660E"
    m_Metadata:
      m_Items: []
  - m_Id: 867233811
    m_Localized: "\u6F5C\u6C34\u8247\u79FB\u52A8"
    m_Metadata:
      m_Items: []
  - m_Id: 867233812
    m_Localized: "\u8981\u79FB\u52A8\u6F5C\u6C34\u8247\uFF0C\u8BF7\u4ECE\u5DE6\u4E0B\u89D2\u7684\u63A7\u5236\u9762\u677F\u8FDB\u884C\u64CD\u4F5C\u3002\n
      \u63A7\u5236\u9762\u677F\u5305\u62EC\"\u5F15\u64CE\u7535\u62A5\u673A\"\u3001\"\u65B9\u5411\u6307\u793A\u76D8\"\u548C\"\u6DF1\u5EA6\u6307\u793A\u76D8\"\uFF0C\u60A8\u53EF\u4EE5\u901A\u8FC7\u64CD\u4F5C\u5B83\u4EEC\u6765\u6539\u53D8\u6F5C\u6C34\u8247\u7684\u5F15\u64CE\u8F93\u51FA\u3001\u884C\u8FDB\u65B9\u5411\u548C\u6DF1\u5EA6\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233813
    m_Localized: "\u89C2\u5BDF\uFF0C\u542C\u58F0\u97F3"
    m_Metadata:
      m_Items: []
  - m_Id: 867233814
    m_Localized: "\u60A8\u53EF\u4EE5\u4ECE\u53F3\u4E0B\u89D2\u7684\u6307\u4EE4\u9762\u677F\u68C0\u67E5\u5468\u56F4\u7684\u72B6\u6001\u3002<br>\n\u901A\u8FC7\u70B9\u51FB\u6BCF\u4E2A\u6309\u94AE\uFF0C\u786E\u8BA4\u7684\u654C\u8230\u4FE1\u606F\u5C06\u5728\u5DE6\u4E0A\u89D2\u7684\u6D88\u606F\u9762\u677F\u4E2D\u663E\u793A\u3002<br>\n\u60A8\u53EF\u4EE5\u901A\u8FC7\u5DE6\u4FA7\u7684\u89C2\u5BDF\u6309\u94AE\u8FDB\u884C\u76EE\u89C6\u89C2\u5BDF\uFF0C\u901A\u8FC7\u4E2D\u592E\u7684\u76D1\u542C\u6309\u94AE\u4F7F\u7528\u6C34\u542C\u5668\u3002<br>\n\u76EE\u89C6\u89C2\u5BDF\u4EC5\u5728\u6F5C\u8247\u6D6E\u51FA\u6C34\u9762\u65F6\u4F7F\u7528\uFF0C\u6C34\u542C\u5668\u4EC5\u5728\u6F5C\u8247\u6F5C\u6C34\u65F6\u4F7F\u7528\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233815
    m_Localized: "\u6F5C\u671B\u955C\u753B\u9762"
    m_Metadata:
      m_Items: []
  - m_Id: 867233816
    m_Localized: "\u60A8\u53EF\u4EE5\u901A\u8FC7\u70B9\u51FB\u53F3\u4E0B\u6307\u4EE4\u9762\u677F\u53F3\u4FA7\u7684\u6F5C\u671B\u955C\u6309\u94AE\u6765\u663E\u793A\u6F5C\u671B\u955C\u753B\u9762\u3002<br>\n\u5728\u6F5C\u671B\u955C\u753B\u9762\u4E0A\uFF0C\u60A8\u53EF\u4EE5\u901A\u8FC7\u6F5C\u671B\u955C\u68C0\u67E5\u654C\u8230\u3001\u8F93\u5165\u9C7C\u96F7\u89C4\u683C\u5E76\u53D1\u5C04\u9C7C\u96F7\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 867233817
    m_Localized: "\u500D\u901F\u663E\u793A"
    m_Metadata:
      m_Items: []
  - m_Id: 871428096
    m_Localized: "\u60A8\u53EF\u4EE5\u901A\u8FC7\u53F3\u4E0A\u72B6\u6001\u9762\u677F\u4E2D\u7684\u65F6\u95F4\u500D\u7387\u6309\u94AE\u6765\u66F4\u6539\u6E38\u620F\u5185\u65F6\u95F4\u7684\u8FDB\u5EA6\u3002<br>\n\u65F6\u95F4\u500D\u7387\u53EF\u4EE5\u8C03\u6574\u4E3A1\u81F316\u500D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 871428097
    m_Localized: "\u654C\u8230\u7684\u884C\u52A8"
    m_Metadata:
      m_Items: []
  - m_Id: 871428098
    m_Localized: "\u654C\u8230\u961F\u901A\u5E38\u4EE5\u6052\u5B9A\u901F\u5EA6\u671D\u7740\u76EE\u7684\u5730\u524D\u8FDB\u3002<br>\n\u7136\u800C\uFF0C\u4E00\u65E6\u53D1\u73B0\u6F5C\u8247\uFF0C\u654C\u8230\u961F\u5C06\u8FDB\u5165\u53CD\u6F5C\u822A\u884C\uFF0C\u5546\u8239\u5C06\u907F\u5F00\u9C7C\u96F7\uFF0C\u800C\u9A71\u9010\u8230\u5C06\u5F00\u59CB\u653B\u51FB\u6F5C\u8247\u3002<br>\n\u9A71\u9010\u8230\u6709\u4E24\u79CD\u653B\u51FB\u65B9\u5F0F\uFF0C\u5982\u679C\u6F5C\u8247\u6D6E\u51FA\u6C34\u9762\uFF0C\u5C06\u4F7F\u7528\u70AE\u51FB\u653B\u51FB\uFF0C\u800C\u6F5C\u8247\u6F5C\u822A\u65F6\uFF0C\u5219\u4F1A\u8FDB\u884C\u6DF1\u6C34\u70B8\u5F39\u653B\u51FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 871428099
    m_Localized: "\u7535\u6C60\uFF0C\u6C27\u6C14\u5269\u4F59"
    m_Metadata:
      m_Items: []
  - m_Id: 871428100
    m_Localized: "\u6F5C\u8247\u4F7F\u7528\u7535\u6C60\u9A71\u52A8\u87BA\u65CB\u6868\uFF0C\u56E0\u6B64\u7535\u6C60\u7535\u91CF\u4F1A\u9010\u6E10\u51CF\u5C11\u3002<br>\n\u5982\u679C\u7535\u6C60\u8017\u5C3D\uFF0C\u60A8\u5C06\u65E0\u6CD5\u524D\u8FDB\u6216\u540E\u9000\uFF0C\u4F46\u4ECD\u7136\u53EF\u4EE5\u6F5C\u6C34\u548C\u6D6E\u51FA\u6C34\u9762\u3002<br>\n\u5728\u822A\u884C\u8FC7\u7A0B\u4E2D\uFF0C\u6C27\u6C14\u91CF\u4F1A\u9010\u6E10\u51CF\u5C11\uFF0C\u56E0\u4E3A\u6F5C\u8247\u6D88\u8017\u6C27\u6C14\u3002<br>\n\u5982\u679C\u6C27\u6C14\u91CF\u4E3A0\uFF0C\u6E38\u620F\u5C06\u7ED3\u675F\uFF0C\u8BF7\u6D6E\u51FA\u6C34\u9762\u6062\u590D\u6C27\u6C14\u3002"
    m_Metadata:
      m_Items: []
