  - m_Id: 867233798
    m_Localized: "\u4E8C\u6B21\u5927\u6226\u6642\u306E\u30CA\u30C1\u30B9\u30C9\u30A4\u30C4\u3067\u306F\u6575\u56FD\u306E\u7D4C\u6E08\u3078\u640D\u5BB3\u3092\u4E0E\u3048\u308B\u3079\u304F\u7121\u5236\u9650\u6F5C\u6C34\u8266\u4F5C\u6226\u3068\u547C\u3070\u308C\u308B\u6F5C\u6C34\u8266\u306B\u3088\u308B\u4F5C\u6226\u304C\u884C\u308F\u308C\u3066\u3044\u307E\u3057\u305F\u3002<br>\n\u672C\u30B2\u30FC\u30E0\u306E\u76EE\u7684\u306F\u3001\u7B2C\u4E8C\u6B21\u5927\u6226\u4E2D\u306E\u30C9\u30A4\u30C4\u6F5C\u6C34\u8266U-Boat\u306E\u8266\u9577\u3068\u3057\u3066\u6F5C\u6C34\u8266\u3092\u6307\u63EE\u3057\u9B5A\u96F7\u653B\u6483\u306B\u3088\u3063\u3066\u6575\u8239\u56E3\u3092\u6483\u6C88\u3059\u308B\u3053\u3068\u3067\u3059\u3002"
