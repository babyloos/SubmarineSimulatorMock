    m_Localized: "\u30B2\u30FC\u30E0\u30E2\u30FC\u30C9\u306B\u306F\u300C\u30B9\u30AB\u30FC\u30DF\u30C3\u30B7\u30E5\u300D\u3068\u300C\u30DF\u30C3\u30B7\u30E7\u30F3\u300D\u304C\u3042\u308A\u307E\u3059\u3002"
